# Copy this file to .env and edit values. No code changes are needed.

# Persian/multilingual semantic search model
EMBED_MODEL=intfloat/multilingual-e5-base

# Ollama generation service and model
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:3b

# Retrieval tuning
TOP_K=4
SUMMARY_TOP_K=12
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Stable, factual answers with bounded memory use
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=4096
